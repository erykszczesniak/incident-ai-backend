# Local demo works without external credentials. Never commit a real .env.
DEMO_MODE=true
API_KEY=incident-ai-demo-key
WEBHOOK_KEY=incident-ai-demo-key
DATABASE_URL=sqlite+aiosqlite:///./var/incident-ai.db
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
AUTO_ANALYZE=false
SLA_TARGET_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=2097152
JWT_SECRET=
JWT_ISSUER=incident-ai
JWT_AUDIENCE=incident-ai-api

# Select demo, openai, or anthropic. Set a supported model for your account.
LLM_PROVIDER=demo
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
INTEGRATION_TIMEOUT_SECONDS=15
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Jira Cloud REST v3 and Confluence Cloud REST v2.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_ID=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# APNs signing key contents. Use escaped newlines in a quoted value.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.erykszczesniak.IncidentAI

# Optional extended S3-compatible archive. The SDK supports IAM roles too.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional OpenTelemetry collector (host.docker.internal when inside Compose).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=incident-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_ADMIN_PASSWORD=incident-ai-local
